POSTGRES_PASSWORD=contraseña de postgres
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
POSTGRES_USER=usuario de postgres
POSTGRES_DB=nombre de la base de datos

# Credenciales del usuario superadmin que el backend garantiza que siempre exista.
# OBLIGATORIO definir SUPERADMIN_PASSWORD en producción (si se omite, se usa una
# contraseña de desarrollo insegura y el backend lo advierte en los logs).
SUPERADMIN_USERNAME=superadmin
SUPERADMIN_PASSWORD=defina-una-contraseña-segura-aqui
SUPERADMIN_EMAIL=superadmin@idsn.gov.co
SUPERADMIN_NUM_ID=10000001
