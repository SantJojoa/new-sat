generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model areas {
  id                        String              @id @default(cuid())
  name                      String              @unique
  subdireccion_id           String
  created_at                DateTime            @default(now())
  updated_at                DateTime            @updatedAt
  subdirecciones            subdirecciones      @relation(fields: [subdireccion_id], references: [id])
  users                     users[]
  salidas                   salidas[]
  solicitudes_union         solicitudes_union[] @relation("SolicitudesUnionArea")
  salidas_como_participante salidas[]           @relation("SalidasAreasParticipantes")
  articulaciones            articulaciones[]    @relation("AreasArticulaciones")
  ivc                       ivc[]               @relation("AreasIvc")
}

model subdirecciones {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt
  areas       areas[]
  users       users[]
}

model user_types {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  level       Int           @default(0)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  users       users[]
  permissions permissions[]
}

model users {
  id              String          @id @default(cuid())
  username        String          @unique
  password        String
  user_type_id    String
  names           String
  last_name       String
  num_id          String          @unique
  area_id         String?
  subdireccion_id String?
  charge          String?
  email           String          @unique
  is_active       Boolean         @default(true)
  created_at      DateTime        @default(now())
  updated_at      DateTime        @updatedAt
  areas           areas?          @relation(fields: [area_id], references: [id])
  subdirecciones  subdirecciones? @relation(fields: [subdireccion_id], references: [id])
  user_types      user_types      @relation(fields: [user_type_id], references: [id])

  salidas_solicitadas           salidas[]           @relation("SolicitanteSalidas")
  salidas_aprobadas             salidas[]           @relation("AprobadorSalidas")
  solicitudes_union_solicitadas solicitudes_union[] @relation("SolicitudesUnionSolicitante")
  notifications                 notifications[]
  articulaciones_solicitadas    articulaciones[]    @relation("SolicitanteArticulaciones")
  ivc_solicitadas               ivc[]               @relation("SolicitanteIvc")
}

model notifications {
  id         String   @id @default(cuid())
  user_id    String
  type       String // 'salida_pendiente','salida_aprobada','salida_rechazada','union_pendiente','union_aceptada','union_rechazada'
  title      String
  message    String
  read       Boolean  @default(false)
  link       String?
  created_at DateTime @default(now())

  user users @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model modules {
  id          String        @id @default(cuid())
  name        String        @unique
  description String?
  icon        String?
  path        String?
  order       Int           @default(0)
  is_active   Boolean       @default(true)
  created_at  DateTime      @default(now())
  updated_at  DateTime      @updatedAt
  permissions permissions[]
  parent_id   String?
  parent      modules?      @relation("ModuleParent", fields: [parent_id], references: [id])
  children    modules[]     @relation("ModuleParent")
}

model permissions {
  id           String   @id @default(cuid())
  user_type_id String
  module_id    String
  can_view     Boolean  @default(false)
  can_create   Boolean  @default(false)
  can_edit     Boolean  @default(false)
  can_delete   Boolean  @default(false)
  can_approve  Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  user_types user_types @relation(fields: [user_type_id], references: [id])
  modules    modules    @relation(fields: [module_id], references: [id])

  @@unique([user_type_id, module_id])
}

// Catálogos
model municipios {
  id         String   @id @default(cuid())
  name       String
  code       String?  @unique // Código DANE
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salidas               salidas[]        @relation("SalidasMunicipios")
  salidas_evento        salidas[]        @relation("SalidaLugarEvento")
  articulaciones_evento articulaciones[] @relation("ArticulacionLugarEvento")
  ivc_evento            ivc[]            @relation("IvcLugarEvento")
}

model ips {
  id         String   @id @default(cuid())
  type       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salida_ips salida_ips[]
}

model ips_actores {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salida_ips salida_ips[]
}

model salida_ips {
  id        String  @id @default(cuid())
  salida_id String
  ips_id    String
  actor_id  String?

  salida salidas      @relation(fields: [salida_id], references: [id], onDelete: Cascade)
  ips    ips          @relation(fields: [ips_id], references: [id])
  actor  ips_actores? @relation(fields: [actor_id], references: [id])

  @@unique([salida_id, ips_id, actor_id])
}

model entidades {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salidas salidas[] @relation("SalidasEntidades")
}

model eapb {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salida_eapb salida_eapb[]
}

model eapb_actores {
  id         String   @id @default(cuid())
  name       String   @unique
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salida_eapb salida_eapb[]
}

model salida_eapb {
  id        String  @id @default(cuid())
  salida_id String
  eapb_id   String
  actor_id  String?

  salida salidas       @relation(fields: [salida_id], references: [id], onDelete: Cascade)
  eapb   eapb          @relation(fields: [eapb_id], references: [id])
  actor  eapb_actores? @relation(fields: [actor_id], references: [id])

  @@unique([salida_id, eapb_id, actor_id])
}

model organizaciones {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salidas salidas[] @relation("SalidasOrganizaciones")
}

model idsn {
  id         String   @id @default(cuid())
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  salidas salidas[] @relation("SalidasIdsn")
}

model salidas {
  id     String @id @default(cuid())
  codigo String @unique

  // Datos de la comisión
  tipo_salida    String // 'Capacitacion Presencial', 'Capacitacion Virtual', etc.
  subtipo_salida String? // 'Inspeccion', 'Vigilancia', 'Acompañamiento'
  tema           String // Descripción corta o título del tema
  descripcion    String? // Descripción detallada (opcional)

  // Agenda
  fecha_inicio DateTime
  fecha_final  DateTime
  jornada      String // 'Manana', 'Tarde', 'Completa'

  // Estado
  fecha_solicitud  DateTime  @default(now())
  fecha_aprobacion DateTime?
  estado           String    @default("pendiente")
  observaciones    String?

  // Datos Transporte
  transporte_medio         String? // 'Pasajero', 'Permanente', 'Institucional', 'No Aplica'
  transporte_responsables  String? // Nombres de responsables
  instituciones_convocadas Int?        @default(0)
  municipios_convocados    String?
  lugar_evento_id          String? // ID del municipio del evento
  lugar_evento             municipios? @relation("SalidaLugarEvento", fields: [lugar_evento_id], references: [id])

  // Relaciones de Usuario/Área
  solicitante_id String
  aprobador_id   String?
  area_id        String

  // Relaciones con Catálogos (Muchos a Muchos implícitos)
  municipios     municipios[]     @relation("SalidasMunicipios")
  entidades      entidades[]      @relation("SalidasEntidades")
  salida_eapb    salida_eapb[]
  salida_ips     salida_ips[]
  organizaciones organizaciones[] @relation("SalidasOrganizaciones")
  idsn           idsn[]           @relation("SalidasIdsn")

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  solicitante         users               @relation("SolicitanteSalidas", fields: [solicitante_id], references: [id])
  aprobador           users?              @relation("AprobadorSalidas", fields: [aprobador_id], references: [id])
  areas               areas               @relation(fields: [area_id], references: [id])
  solicitudes_union   solicitudes_union[]
  areas_participantes areas[]             @relation("SalidasAreasParticipantes")
}

model articulaciones {
  id     String @id @default(cuid())
  codigo String @unique

  tipo_programacion String // 'Articulación Intersectorial'
  tema              String
  fecha_inicio      DateTime
  fecha_final       DateTime
  jornada           String // 'Manana', 'Tarde', 'Completa'

  instituciones_convocadas String? // nombres separados por coma

  transporte_medio             String?
  transporte_num_instituciones Int?
  lugar_evento_id              String?
  lugar_evento                 municipios? @relation("ArticulacionLugarEvento", fields: [lugar_evento_id], references: [id])

  responsable_articulacion String?

  estado          String   @default("pendiente")
  observaciones   String?
  fecha_solicitud DateTime @default(now())

  solicitante_id String
  area_id        String

  solicitante users @relation("SolicitanteArticulaciones", fields: [solicitante_id], references: [id])
  areas       areas @relation("AreasArticulaciones", fields: [area_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model ivc {
  id     String @id @default(cuid())
  codigo String @unique

  tipo_programacion String // 'IVC'
  tema              String
  fecha_inicio      DateTime
  fecha_final       DateTime
  jornada           String // 'Manana', 'Tarde', 'Completa'

  instituciones_convocadas String?

  transporte_medio             String?
  transporte_num_instituciones Int?
  lugar_evento_id              String?
  lugar_evento                 municipios? @relation("IvcLugarEvento", fields: [lugar_evento_id], references: [id])

  responsable_articulacion String?

  estado          String   @default("pendiente")
  observaciones   String?
  fecha_solicitud DateTime @default(now())

  solicitante_id String
  area_id        String

  solicitante users @relation("SolicitanteIvc", fields: [solicitante_id], references: [id])
  areas       areas @relation("AreasIvc", fields: [area_id], references: [id])

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
}

model solicitudes_union {
  id                  String   @id @default(cuid())
  salida_id           String
  solicitante_id      String
  area_solicitante_id String
  mensaje             String?
  estado              String   @default("pendiente") // 'pendiente', 'aceptada', 'rechazada'
  respuesta           String?
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  salida           salidas @relation(fields: [salida_id], references: [id])
  solicitante      users   @relation("SolicitudesUnionSolicitante", fields: [solicitante_id], references: [id])
  area_solicitante areas   @relation("SolicitudesUnionArea", fields: [area_solicitante_id], references: [id])
}
